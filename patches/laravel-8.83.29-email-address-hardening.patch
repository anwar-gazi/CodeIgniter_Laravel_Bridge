+    protected function ensureAddressIsSafe($address)
+    {
+        foreach ((array) $address as $key => $value) {
+            // Associative arrays use email addresses as keys and display names
+            // as values. Numerically indexed arrays contain address values.
+            $candidate = is_string($key) ? $key : $value;
+
+            if (is_string($candidate) && preg_match('/[\r\n]/', $candidate) > 0) {
+                throw new InvalidArgumentException(
